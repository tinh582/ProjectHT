SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend only. Never put this key in frontend/.env or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
REPORT_TIME_ZONE=Asia/Ho_Chi_Minh

# Optional: Real Gmail / SMTP sender for 6-digit Email OTP verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-digit-google-app-password
